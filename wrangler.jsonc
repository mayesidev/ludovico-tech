{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ludovico-tech",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-03",
  "preview_urls": false,
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "development": {
      "name": "ludovico-tech-development",
      "workers_dev": false,
      "triggers": {
        "crons": [],
      },
      "vars": {
        "APP_ENV": "development",
        "AUTH_MODE": "development",
      },
      "secrets": {
        "required": ["TMDB_READ_ACCESS_TOKEN"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ludovico-tech-development",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "preview_database_id": "ludovico-tech-development-local",
          "migrations_dir": "migrations",
        },
      ],
    },
    "staging": {
      "name": "ludovico-tech-staging",
      "workers_dev": false,
      "triggers": {
        "crons": ["*/15 * * * *"],
      },
      "routes": [
        {
          "pattern": "staging.ludovicotech.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "AUTH_MODE": "google",
      },
      "secrets": {
        "required": [
          "TMDB_READ_ACCESS_TOKEN",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "GOOGLE_REDIRECT_URI",
          "ALLOWED_EMAILS",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ludovico-tech-staging",
          "database_id": "52c09893-fe99-4629-9150-ab642540171a",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "ludovico-tech-production",
      "workers_dev": false,
      "triggers": {
        "crons": ["*/15 * * * *"],
      },
      "routes": [
        {
          "pattern": "ludovicotech.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "AUTH_MODE": "google",
      },
      "secrets": {
        "required": [
          "TMDB_READ_ACCESS_TOKEN",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "GOOGLE_REDIRECT_URI",
          "ALLOWED_EMAILS",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ludovico-tech-production",
          "database_id": "a93c4d94-63a6-48fd-8ce0-3e9cc8dd8987",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
