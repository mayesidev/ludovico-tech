# TMDB read-only API token used by the Worker when contributors search for titles.
TMDB_READ_ACCESS_TOKEN=

# Google OAuth credentials and callback used for production sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Comma-separated invite list. Keep real addresses in secret storage only.
ALLOWED_EMAILS=
