{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "prHourlyLimit": 0,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge stable npm patch and minor updates",
      "matchManagers": ["npm"],
      "matchDatasources": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchNewValue": "/^[~^]?v?[0-9]+\\.[0-9]+\\.[0-9]+(?:\\+[0-9A-Za-z.-]+)?$/",
      "automerge": true
    },
    {
      "description": "Review minor updates to pre-1.0 packages",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Review package manager and release tooling updates",
      "matchPackageNames": [
        "pnpm",
        "semantic-release",
        "@semantic-release/**",
        "conventional-changelog-conventionalcommits"
      ],
      "automerge": false
    },
    {
      "description": "Keep the coupled Cloudflare development toolchain compatible",
      "matchPackageNames": [
        "@cloudflare/vite-plugin",
        "@cloudflare/vitest-plugin",
        "@cloudflare/workers-types",
        "wrangler"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Cloudflare development toolchain",
      "automerge": false
    },
    {
      "description": "Keep ESLint peer-resolved tooling updates together",
      "matchPackageNames": [
        "@eslint/js",
        "eslint",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "typescript-eslint"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ESLint toolchain"
    },
    {
      "description": "Upgrade the coupled semantic-release notes toolchain together",
      "matchPackageNames": [
        "@semantic-release/release-notes-generator",
        "conventional-changelog-conventionalcommits"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "semantic-release notes toolchain",
      "minimumGroupSize": 2
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
