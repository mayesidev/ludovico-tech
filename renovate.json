{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Keep the coupled Cloudflare development toolchain compatible",
      "matchPackageNames": [
        "@cloudflare/vite-plugin",
        "@cloudflare/vitest-pool-workers",
        "@cloudflare/workers-types",
        "wrangler"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Cloudflare development toolchain"
    },
    {
      "description": "Upgrade the coupled semantic-release notes toolchain together",
      "matchPackageNames": [
        "@semantic-release/release-notes-generator",
        "conventional-changelog-conventionalcommits"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "semantic-release notes toolchain",
      "minimumGroupSize": 2
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
