{
  "name": "ludovico-tech",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"wrangler dev src/worker/index.ts --local --env development\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "tsx scripts/validate-cloudflare-config.ts",
    "config:check:production": "tsx scripts/validate-cloudflare-config.ts --production",
    "check": "pnpm config:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "import:sanitize": "tsx scripts/sanitize-sheet.ts",
    "import:generate": "tsx scripts/generate-import.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.34",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-istanbul": "4.1.10",
    "concurrently": "^10.0.4",
    "csv-parse": "^7.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
