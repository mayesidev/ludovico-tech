{
  "name": "ludovico-tech",
  "private": true,
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=development vite --host 0.0.0.0",
    "build": "pnpm build:production",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production-family-bonding": "CLOUDFLARE_ENV=production-family-bonding vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "tsx scripts/validate-cloudflare-config.ts",
    "config:check:staging": "tsx scripts/validate-cloudflare-config.ts --staging",
    "config:check:production": "tsx scripts/validate-cloudflare-config.ts --production",
    "config:check:production-family-bonding": "tsx scripts/validate-cloudflare-config.ts --production-family-bonding",
    "audit:production": "node scripts/production-audit.ts",
    "licenses:check": "pnpm licenses list --prod --json | node scripts/production-licenses.ts",
    "check": "pnpm config:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "import:catalog": "tsx scripts/import-catalog.ts",
    "release:gate": "node scripts/release-gates.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.7",
    "lucide-react": "1.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/vitest-plugin": "1.1.7",
    "@cloudflare/workers-types": "5.20260910.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "csv-parse": "7.0.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "jsonc-parser": "3.3.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
